# Supabase project URL from Project Settings > API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Supabase anon/publishable key only. NEVER put service_role/secret keys in VITE_ variables.
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Existing AI Studio runtime variables, if needed by this project
GEMINI_API_KEY="SET_IN_AI_STUDIO_SECRETS_ONLY"
APP_URL="SET_BY_HOSTING_PROVIDER"
